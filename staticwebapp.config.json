{
  "routes": [
    {
      "route": "/*",
      "serve": "/index.html",
      "statusCode": 200
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/images/*", "/*.json", "/*.txt", "/*.ico"]
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  }
}
